meta {
  name: Get Road By System Id - 404
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/road/{{missingRoadSystemId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("status should be 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("error payload should describe missing road", function () {
    let body = res.getBody();
    if (typeof body === "string") {
      body = JSON.parse(body);
    }

    expect(body.success).to.equal(false);
    expect(body.error).to.be.an("object");
    expect(body.error.code).to.equal("ROAD_NOT_FOUND");
    expect(body.error.message).to.include(bru.getVar("missingRoadSystemId"));
  });
}
